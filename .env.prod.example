# App runtime
APP_ENV=production
APP_IMAGE=ghcr.io/csuarezgurruchaga/chatbot-das:2026-04-17-1
SESSION_SECRET=change-me
BOT_MENU_YAML_PATH=/app/config/bot.yaml

# Infra images (pin explicit versions; do not use floating tags)
MYSQL_IMAGE=mysql:8.4.6
NGINX_IMAGE=nginx:1.29.0-alpine

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me

# Optional webhook allowlist
WHATSAPP_WEBHOOK_ALLOWLIST_ENABLED=false
WHATSAPP_WEBHOOK_ALLOWLIST_CIDRS=

# MySQL container bootstrap (DATABASE_URL is derived from these values by docker-compose.prod.yml)
MYSQL_DATABASE=chatbot_das
MYSQL_USER=chatbot_das_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Extras storage + feature flags
ATTACHMENTS_DIR=/data/attachments
EXPORTS_DIR=/data/exports
EXPORTS_TTL_DAYS=7
FEATURE_ATTACHMENTS_ENABLED=true
FEATURE_EXPORTS_ENABLED=true
FEATURE_HARD_DELETE_ENABLED=true
FEATURE_TAXONOMY_ADMIN_ENABLED=true

# Host bind mounts for docker-compose.prod.yml
MYSQL_DATA_DIR=/srv/chatbot-das/mysql
ATTACHMENTS_HOST_DIR=/srv/chatbot-das/attachments
EXPORTS_HOST_DIR=/srv/chatbot-das/exports
TLS_CERTS_DIR=/srv/chatbot-das/certs
APP_ENV_FILE=/srv/chatbot-das/env/.env.prod
