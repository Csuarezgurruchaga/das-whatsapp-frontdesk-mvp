prefix_rule(pattern=["git", "add", "docs/specs/focusmate-landing/TASKS.md", "docs/specs/focusmate-landing/CHECKPOINT.md"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "add", "docs/specs/focusmate-landing/CHECKPOINT.md", "docs/specs/focusmate-landing/TASKS.md"], decision="allow")
prefix_rule(pattern=["git", "commit", "-m", "feat(focusmate-landing): T2.1 fixed navbar + smooth scroll"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git add app.js styles.css && git commit -m \"feat(focusmate-landing): T2.2 FAQ accordion\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git add docs/specs/focusmate-landing/CHECKPOINT.md docs/specs/focusmate-landing/TASKS.md && git commit -m \"docs(focusmate-landing): update execution status after T2.2\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git push origin impl/focusmate-landing"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git add index.html styles.css app.js && git commit -m \"feat(focusmate-landing): T2.3 implement privacy/terms modals\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git add docs/specs/focusmate-landing/TASKS.md docs/specs/focusmate-landing/CHECKPOINT.md && git commit -m \"docs(focusmate-landing): update execution status after T2.3\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git push"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git status -sb"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cd \"$PWD\" && git log -2 --oneline"], decision="allow")
